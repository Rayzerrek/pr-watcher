{
  "name": "pr-watcher",
  "version": "0.1.0",
  "description": "CLI watcher for GitHub pull requests and CI checks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayzerrek/pr-watcher.git"
  },
  "bin": {
    "pr-watcher": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.33.0"
}
